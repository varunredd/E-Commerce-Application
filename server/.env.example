# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/<dbname>

# JWT
JWT_SECRET=your_random_secret_key_here

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# PayPal
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret

# Resend (Email)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=E-Commerce <onboarding@resend.dev>
APP_NAME=ShopVerse

# Jobform Integration (Customer Support)
JOBFORM_BASE_URL=http://localhost:3000
BUSINESS_INTEGRATION_SECRET=your_shared_secret_at_least_32_chars_long

# App
PORT=5011
NODE_ENV=development

# CLIENT_URL — for development or multi-origin CORS
# In production same-origin deploy, set to your Railway URL
# Supports comma-separated origins: https://myapp.up.railway.app,http://localhost:5173
CLIENT_URL=http://localhost:5173
